---
import Layout from "../layouts/MainLayout.astro";
import Event from "../components/Event.astro";
---

<Layout title="Events | Jeremiah Lockwood">
  <h1 class="mx-auto mt-10 mb-20 px-10 text-center text-4xl font-bold">
    Upcoming Events
  </h1>
  <div class="mx-auto flex max-w-3xl flex-col gap-2 px-10 text-xl">
    <div class="text-center">
      <h2 class="text-2xl font-bold">
        Khazones Underground Concert at Indiana University
      </h2>
      <p>Sunday October 11</p>
      <div class="mx-auto mt-4 flex max-w-[60ch] flex-col gap-4 opacity-85">
        <p>
          Please join the Borns Jewish Studies Program at Indiana University
          Bloomington on Sunday, October 11, 2026 for Memory Transformed:
          Materials of Heritage in Jewish Eastern European Life, a full day of
          programming exploring Jewish cultural heritage, culture, and music.
        </p><p>The day’s events include:</p>
        <p>
          11:00 am – Complimentary Brunch<br />Tudor Room, Indiana Memorial
          Union
        </p>
        <p>
          12:30–3:00 pm – Symposium<br />Dogwood Room, Indiana Memorial Union<br
          />Featuring two panels of scholars and artists discussing Jewish
          material culture, music, memory, and the afterlives of cultural
          objects.
        </p>
        <p>
          3:30–6:00 pm – Reception<br />Sidney and Lois Eskenazi Museum of Art<br
          />Free and open to the public.
        </p>
        <p>
          4:00 &amp; 5:00 pm – Guided Museum Tours<br />Sidney and Lois Eskenazi
          Museum of Art<br />Advance registration is required for the tours, and
          space is limited.
        </p>
        <p>
          7:00 pm – Concert<br />Auer Hall<br />Featuring The Sway Machinery and
          The Immortal Khazntes.
        </p>
        <p>
          The full schedule, event details, and registration information are
          available here:<br /><a
            href="https://jewishstudies.indiana.edu/news-events/news/memory-transformed.html"
            >https://jewishstudies.indiana.edu/news-events/news/memory-transformed.html</a
          >
        </p>
        <p>We hope to see you in Bloomington on October 11!</p>
      </div>
    </div>

    <div class="h-20"></div>

