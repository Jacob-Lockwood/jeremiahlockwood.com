---
import Layout from "../layouts/MainLayout.astro";
import Event from "../components/Event.astro";
---

<Layout title="Events | Jeremiah Lockwood">
  <h1 class="mx-auto mb-20 mt-10 px-10 text-center text-4xl font-bold">
    Upcoming Events
  </h1>
  <div class="mx-auto flex max-w-3xl flex-col gap-2 px-10 text-xl">
    <h2 class="text-2xl font-bold">
      High Holidays with Livluv (formerly known as Because Jewish)
    </h2>
    <p>
      Join Jeremiah Lockwood and members of The Sway Machinery and many special
      guests for a unique, music-focused exploration of the "Days of Awe" in a
      community focused on deep listening, joy, and seeking. Together we will
      achieve moments of interiority and transformation!
    </p>
    <Event
      title="Erev Rosh Hashanah"
      date="Friday, September 11 7pm"
      venue="Nu Blu Classic"
      address="62 Loisaida Ave (Avenue C), New York, NY 10009"
    >
      <p>
        Music focused service, followed by a set from Armo, a project of Jordan
        McLean (featuring members of Antibalas).
      </p>
      <p>
        https://www.eventbrite.com/e/first-night-rosh-hashanah-tickets-1993711085526
      </p>
    </Event>
    <Event
      title="Rosh Hashanah morning at Brooklyn Bowl"
      date="Saturday, September 12 9am doors, service begins at 10am"
      venue="Brooklyn Bowl"
      address="61 Wythe Avenue, Brooklyn, NY 11249"
    >
      <p>
        includes: 10am Music Focused Service 12:30pm Festive Blue Ribbon Lunch
      </p>
      <p>
        https://www.brooklynbowl.com/brooklyn/events/detail/a-musical-celebration-of-rosh-hashanah-k7vgf_clftrdf
      </p>
    </Event>
    <Event title="Kol Nidre" date="Sunday September 20">
      <p>Check back soon for details!</p>
    </Event>
    <div class="h-20"></div>
    <Event
      title="Carolina Slim 100th Birthday Celebration"
      date="Sunday September 13 7:00 - 10:00 PM (Doors at 6:30PM)"
      venue="Jalopy Theater"
      address="315 Columbia St, Brooklyn, New York"
    >
      <p>
        Disciples and friends of the late blues musician Carolina Slim
        (1926-2014) will gather at Jalopy Theater to celebrate the life, music
        and memory of one of the last exponents of the traditional rural
        Piedmont Blues tradition. Featuring sets by The Fraternal Order of the
        Society Blues, Bill Carney's Jug Addicts, and Harlem Slim.
      </p>
      <p>https://www.viewcy.com/event/carolina_slim_100th_b</p>
    </Event>
    <div class="h-20"></div>
    <Event
      title="Khazones Underground Concert at Indiana University"
      date="Sunday October 11 7pm (doors at 6:30pm)"
    >
      <p>
        Khazones Underground, a new record label founded by Judith Berkson and
        Jeremiah Lockwood, will present music from two recent releases, in
        collaboration with the Born Jewish Studies Program at Indiana
        University. Part of a day long program Memory Transformed: Materials of
        Heritage in Eastern European Jewish Life - also including a symposium
        (featuring talks by Lockwood and Berkson) and private museum tour with
        museum curator Jenny McComas.
      </p>
      <p>Check back for more details soon!</p>
    </Event>
    <div class="h-20"></div>
    <Event
      title="Gordon Lockwood at TerraBlues"
      date="Thursday December 17 7-9:30pm"
      venue="TerraBlues"
      address="149 Bleecker Street"
    >
      <p>https://gordonlockwood.com/</p>
      <p>https://www.terrablues.com/</p>
    </Event>
    <Event
      title="Gordon Lockwood at TerraBlues"
      date="Thursday January 7 7-9:30pm"
      venue="TerraBlues"
      address="149 Bleecker Street"
    >
      <p>https://gordonlockwood.com/</p>
      <p>https://www.terrablues.com/</p>
    </Event>
  </div>
</Layout>
