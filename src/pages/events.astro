---
import Layout from "../layouts/MainLayout.astro";
import Event from "../components/Event.astro";
---

<Layout title="Events | Jeremiah Lockwood">
  <h1 class="mx-auto mb-20 mt-10 px-10 text-center text-4xl font-bold">
    Upcoming Events
  </h1>
  <div class="grid gap-10 px-5 lg:grid-cols-3 lg:px-20">
    <Event
      title="With the Ebony Hillbillies"
      date="Thursday, June 4, 2026 6pm"
      address="Langston Hughes Community Library and Cultural Center (100-01 Northern Boulevard, Corona, NY 11368)"
      description={["https://theebonyhillbillies.com/"]}
    />

    <Event
      title="Gordon Lockwood at Terra Blues"
      date="Thursday, June 11, 2026 7-9:30pm"
      address="149 Bleecker Street, Manhattan"
      description={["https://www.terrablues.com/"]}
    />

    <Event
      title="With the Ebony Hillbillies"
      date="Sunday, June 14, 2026 2-7pm"
      address="Jackie Robinson Park Bandshell (W. 150th Street & Bradhurst Ave)"
      description={["Showtime approx. 5pm", "https://theebonyhillbillies.com/"]}
    />

    <Event
      title="With the Ebony Hillbillies"
      date="Sunday, June 21, 2026"
      address="Croton Point Park, NY"
      description={[
        "Hudson River Music Festival",
        "https://theebonyhillbillies.com/",
        "https://www.hudsonrivermusicfestival.com",
      ]}
    />

    <Event
      title="Selichos/Transformation - Krakow Jewish Culture Festival"
      date="Thursday, July 2, 2026 at 21:00"
      address="Tempel Synagogue | Miodowa 24, 30-001 Kraków"
      description={[
        "European debut",
        "New music in the cantorial tradition, composed by Jeremiah Lockwood",
        "Featuring Yoel Kohn and Riki Rose",
        "Chamber orchestra conducted by Alan Pierson",
        "https://jewishfestival.pl/en/blog/2026/05/10/concerts-of-the-35thjcf/",
      ]}
    />

    <Event
      title="Closing concert - Krakow Jewish Culture Festival"
      date="Saturday, July 4, 2026"
      address=""
      description={[
        "https://jewishfestival.pl/en/blog/2026/05/10/concerts-of-the-35thjcf/",
      ]}
    />

    <Event
      title="Jeremiah Lockwood’s Annual Barbes Residency"
      date="Saturdays in July, 6pm"
      address="Barbes-376 9th St Brooklyn NY 11215"
      description={["https://www.barbesbrooklyn.com/"]}
    />

    <Event
      title="Peach Cobbler"
      date="Saturday, July 11, 2026 at 6pm"
      address="Barbes-376 9th St Brooklyn NY 11215"
      description={[
        "Songwriter and virtuoso fingerpicking guitarist Jeremiah Lockwood (The Sway Machinery, Carolina Slim) teams up with percussionist Ronald McBee (Sun Ra Arkestra) and David Colding (The Ebony Hillbillies) for a set of new and old time blues and ballads.",
        "https://www.barbesbrooklyn.com/",
      ]}
    />

    <Event
      title="Jeremiah Lockwood and Jake Shulman-Ment"
      date="Saturday, July 18, 2026 at 6pm"
      address="Barbes-376 9th St Brooklyn NY 11215"
      description={[
        "Jeremiah Lockwood and Jake Shulman-Ment, “one of the finest klezmer fiddlers on the planet” (NPR), present a concert of old/new Yiddish music: khazones (spiritual music), Yiddish ballads, and klezmer.",
        "https://www.barbesbrooklyn.com/",
      ]}
    />

    <Event
      title="Gordon Lockwood"
      date="Saturday, July 25, 2026 at 6pm"
      address="Barbes-376 9th St Brooklyn NY 11215"
      description={[
        "Jeremiah Lockwood and Ricky Gordon, two disciples of blues legend Carolina Slim, have been making music together for over three decades. Expect old time blues and new time rhythm.",
        "https://gordonlockwood.com",
        "https://www.barbesbrooklyn.com/",
      ]}
    />

    <Event
      title="Gordon Lockwood at Terra Blues"
      date="Thursday, July 16, 2026 7-9:30pm"
      address="149 Bleecker Street, Manhattan"
      description={["https://www.terrablues.com/"]}
    />

    <Event
      title="Gordon Lockwood at Terra Blues"
      date="Thursday, August 13, 2026 7-9:30pm"
      address="149 Bleecker Street, Manhattan"
      description={["https://www.terrablues.com/"]}
    />
  </div>
</Layout>
